<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="E2Theme" parent="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:textColor">@color/text</item>
    </style>
    <style name="E2Dialog" parent="@android:style/Theme.DeviceDefault.Dialog.Alert">
        <item name="android:colorAccent">@color/accent</item>
    </style>
    <style name="E2Tab">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:layout_marginRight">8dp</item>
        <item name="android:background">@drawable/tab_bg</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="android:textColor">@color/text_hi</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
