msgstr "Tekstitykset"

#: box/info.py
msgid "The app language is chosen on the TV in the TOOLS menu (by default the TV's language)."
msgstr "Sovelluksen kieli valitaan TV:llä TOOLS-valikosta (oletuksena TV:n kieli)."

#: box/info.py
msgid "The OpenWebif port is %s. The old Samsung app sync only works on port 80."
msgstr "OpenWebifin portti on %s. Vanhan Samsungin sovellussynkka toimii vain portissa 80."

#: box/info.py
msgid "Box address:"
msgstr "Boksin osoite:"

#: box/info.py
msgid "<ol><li>Install the <b>Downloader</b> app (AFTVnews) on the TV from Google Play.</li><li>In the settings, allow Downloader to <i>install unknown apps</i>.</li><li>Enter the address <b>%(h)s/%(m)s</b> in Downloader and choose the link below.</li></ol>"
msgstr "<ol><li>Asenna televisioon Google Playsta sovellus <b>Downloader</b> (AFTVnews).</li><li>Salli asetuksista Downloaderille <i>tuntemattomien sovellusten asennus</i>.</li><li>Kirjoita Downloaderiin osoite <b>%(h)s/%(m)s</b> ja valitse alta linkki.</li></ol>"

#: box/info.py
